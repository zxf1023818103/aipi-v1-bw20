
#
# --------MENUCONFIG FOR General---------
#
CONFIG_AMEBA_RLS=y
CONFIG_AMEBADPLUS=y
CONFIG_SUPPORT_SDIO_DEVICE=y
CONFIG_SUPPORT_USB=y
CONFIG_SUPPORT_USB_DEVICE_ONLY=y
CONFIG_SUPPORT_USB_FS_ONLY=y
CONFIG_SUPPORT_USB_NO_PHY=y
CONFIG_SUPPORT_USB_SHARED_DFIFO=y
CONFIG_SUPPORT_USBD_INIC=y
CONFIG_SUPPORT_USBD_UAC=y
CONFIG_SUPPORT_HEAP_TRACE=y
CONFIG_WIFI_POWER_TABLE_USRCFG_1v8=y
CONFIG_WIFI_POWER_TABLE_USRCFG_3v3_1v25=y
CONFIG_SUPPORT_AUDIO_CMD_ARECORD=y
CONFIG_SUPPORT_AUDIO_CMD_APLAY=y
CONFIG_SUPPORT_AUDIO_CMD_PLAYER=y

#
# CONFIG TrustZone
#
# CONFIG_TRUSTZONE is not set
# end of CONFIG TrustZone

#
# CONFIG Memory Arch
#
# CONFIG_SECOND_FLASH_NOR is not set
# end of CONFIG Memory Arch

#
# CONFIG Link Option
#
CONFIG_IMG1_FLASH=y
# CONFIG_IMG1_SRAM is not set
# CONFIG_IMG2_FLASH is not set
CONFIG_IMG2_PSRAM=y
# CONFIG_DATA_HEAP_SRAM is not set
CONFIG_DATA_HEAP_PSRAM=y
CONFIG_PSRAM_USED=y
# end of CONFIG Link Option

#
# CONFIG Mass Production
#
# CONFIG_MP_INCLUDED is not set
# end of CONFIG Mass Production

#
# CONFIG SHELL
#
CONFIG_SHELL=y
CONFIG_LONGER_CMD=y
CONFIG_SUPPORT_ATCMD=y
CONFIG_ATCMD_MANUAL_TEST=y
# CONFIG_ATCMD_HOST_CONTROL is not set
CONFIG_ATCMD_NETWORK=y
CONFIG_SHELL_TASK_STACK_BASIC_SIZE=848
# end of CONFIG SHELL

#
# CONFIG RTK Assert Level
#
CONFIG_ASSERTION_ENABLE=y
# CONFIG_ASSERTION_SILENT is not set
# CONFIG_ASSERTION_DISABLE is not set
# end of CONFIG RTK Assert Level

#
# CONFIG VFS
#
CONFIG_VFS_LITTLEFS_INCLUDED=y
# CONFIG_LITTLEFS_SECOND_FLASH_MENU is not set
# CONFIG_VFS_FATFS_INCLUDED is not set
# end of CONFIG VFS

#
# CONFIG OS
#
CONFIG_KERNEL=y
CONFIG_PLATFORM_FREERTOS=y
# CONFIG_PLATFORM_ZEPHYR is not set
CONFIG_BACK_TRACE_DEPTH_LIMIT=8
# CONFIG_HEAP_PROTECTOR is not set
# CONFIG_HEAP_CORRUPTION_DETECT_LITE is not set
# CONFIG_HEAP_CORRUPTION_DETECT_COMPREHENSIVE is not set
# CONFIG_HEAP_INTEGRITY_CHECK_IN_TASK_SWITCHED_OUT is not set
# CONFIG_HEAP_TRACE is not set
# CONFIG_STANDARD_TICKLESS is not set
# end of CONFIG OS

#
# CONFIG OTA OPTION
#
CONFIG_OTA_SWITCH_STRATEGY=y
CONFIG_OTA_SWITCH_BY_VERSION=y
# CONFIG_OTA_SWITCH_BY_VALID_HEADER is not set
CONFIG_UPGRADE_BOOTLOADER=y
CONFIG_COMPRESS_OTA_IMG=y
# end of CONFIG OTA OPTION

#
# CONFIG USB
#
CONFIG_USB_OTG_EN_MENU=y
CONFIG_USB_DEVICE_EN_MENU=y

#
# USB Device Class
#
CONFIG_USBD_CDC_ACM_MENU=y
# CONFIG_USBD_COMPOSITE_MENU is not set
# CONFIG_USBD_HID_MENU is not set
# CONFIG_USBD_INIC_MENU is not set
# CONFIG_USBD_MSC_MENU is not set
# CONFIG_USBD_UAC_MENU is not set
# CONFIG_USBD_VENDOR_MENU is not set
# end of CONFIG USB

#
# CONFIG APPLICATION
#

#
# Graphics Libraries Configuration
#

#
# Graphics Library Selection
#
CONFIG_LVGL_ENABLE=y
# CONFIG_LVGL_8_3 is not set
CONFIG_LVGL_9_3=y
CONFIG_LV_DEMO_WIDGETS=y
# CONFIG_LV_DEMO_STRESS is not set
# CONFIG_LV_DEMO_MUSIC is not set
# CONFIG_LV_DEMO_BENCHMARK is not set
# end of Graphics Library Selection

#
# Third Party Libraries
#
CONFIG_LIBJPEG_TURBO_ENABLE=y
CONFIG_LIBPNG_ENABLE=y
CONFIG_ZLIB_ENABLE=y
# end of Third Party Libraries
# end of Graphics Libraries Configuration

#
# Audio Config
#
# CONFIG_AUDIO_FWK_MENU is not set
# CONFIG_MEDIA_PLAYER_MENU is not set

#
# Third Party Lib
#
# CONFIG_SPEEX_LIB_MENU is not set
# CONFIG_OPUS_LIB_MENU is not set
# end of Third Party Lib

#
# CONFIG AUDIO CMD
#
# CONFIG_SUPPORT_AUDIO_CMD is not set
# end of CONFIG AUDIO CMD
# end of Audio Config

#
# AI Config
#
# CONFIG_TFLITE_MICRO_EN_MENU is not set
# CONFIG_AIVOICE_EN_MENU is not set
# end of AI Config

# CONFIG_DIAGNOSE_EN_MENU is not set
# end of CONFIG APPLICATION

#
# -----Connectivity config-----
#

#
# CONFIG WHC INTF
#
CONFIG_WHC_INTF_IPC_MENU=y
# CONFIG_WHC_DEV_MENU is not set
# CONFIG_WHC_HOST_MENU is not set
CONFIG_WHC_WIFI_API_PATH=y
CONFIG_WHC_HOST_FOR_KM4=y
CONFIG_WHC_DEV_FOR_KM0=y
# end of CONFIG WHC INTF

CONFIG_VFS_MENU=y
CONFIG_VFS_ENABLED_FOR_KM4=y

#
# CONFIG WIFI
#
CONFIG_WLAN_MENU=y

#
# CONFIG WIFI MODE
#
# CONFIG_WIFI_P2P_ENABLE is not set
# end of CONFIG WIFI MODE

# CONFIG_WIFI_WPS_ENABLE_MENU is not set
# CONFIG_WIFI_EAP_ENABLE is not set
# CONFIG_WIFI_CSI_ENABLE is not set
# CONFIG_WIFI_ANTDIV_ENABLE is not set
# CONFIG_WIFI_MCC_ENABLE is not set
# CONFIG_WIFI_11K_ENABLE is not set
# CONFIG_WIFI_11V_ENABLE is not set
# CONFIG_WIFI_11R_ENABLE is not set
# CONFIG_WIFI_SPEAKER_ENABLE is not set
# CONFIG_HIGH_TP_TEST is not set
# CONFIG_RMESH_EN is not set
CONFIG_WLAN_CRITICAL_CODE_IN_RAM=y
CONFIG_WIFI_FW_EN_FOR_KM0=y
CONFIG_WLAN=y
CONFIG_WHC_INTF_IPC=y
# end of CONFIG WIFI

#
# CONFIG BT
#
CONFIG_BT_MENU=y
CONFIG_BT_HAS_MESH=y
CONFIG_BT_ADVANCED_FEATURE_MENU=y
# CONFIG_BT_EXCLUDE_AT_COMMAND is not set
# CONFIG_BT_EXAMPLE_DEMO_MENU is not set
# end of CONFIG BT

#
# CONFIG LWIP
#
CONFIG_FAST_DHCP_MENU=y
# CONFIG_IP_NAT_MENU is not set
CONFIG_LWIP_IPV6_MENU=y
# CONFIG_LWIP_SKIP_CHECK_UDP_CHECKSUM is not set
# CONFIG_LWIP_DEBUG is not set
# CONFIG_LWIP_STATS is not set
CONFIG_PBUF_POOL_BUFSIZE=508
# end of CONFIG LWIP

#
# CONFIG SSL
#
CONFIG_MBEDTLS_ENABLED_MENU=y
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3_MENU=y
CONFIG_MBEDTLS_THREADING=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN_MENU=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN_MENU=4096
# CONFIG_GMSSL_ENABLED is not set
# end of CONFIG SSL

#
# CONFIG COEX
#
CONFIG_COEX_MENU=y
# CONFIG_COEXIST_EXT_MENU is not set
# end of CONFIG COEX

#
# --------Build Config---------
#

#
# Build Option
#

#
# Choose the build configuration
#
# CONFIG_LINK_ROM_LIB is not set
CONFIG_LINK_ROM_SYMB=y
# end of Build Option

#
# ----end of MENUCONFIG FOR General------
#

#
# MENUCONFIG FOR KM0 CONFIG
#

#
# ----------CPU config----------
#

#
# CONFIG CHIP
#
CONFIG_ARM_CORE_CM0_FOR_KM0=y
# end of CONFIG CHIP
# end of MENUCONFIG FOR KM0 CONFIG

#
# MENUCONFIG FOR KM4 CONFIG
#

#
# ----------CPU config----------
#

#
# CONFIG CHIP
#
CONFIG_CPU_HAS_FPU_FOR_KM4=y
CONFIG_ARM_CORE_CM4_FOR_KM4=y
# end of CONFIG CHIP
# end of MENUCONFIG FOR KM4 CONFIG

